[Unit]
Description=CaraProjetada — Servidor WebRTC de Projeções
After=network.target
Wants=network.target

[Service]
Type=simple
User=carapreta
WorkingDirectory=/home/carapreta
Environment="PORT=5000"
Environment="CARAPROJETADA_ENV=prod"
ExecStart=/usr/bin/python3 /home/carapreta/app.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/flask-webrtc.log
StandardError=append:/tmp/flask-webrtc.log

[Install]
WantedBy=multi-user.target
